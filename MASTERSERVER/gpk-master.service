[Unit]
Description=GPK multiplayer master server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gpkmaster
Group=gpkmaster
WorkingDirectory=/opt/gpk-master
ExecStart=/usr/bin/python3 /opt/gpk-master/master_server.py --host 0.0.0.0 --port 29029
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
